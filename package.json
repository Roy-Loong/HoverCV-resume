{
  "name": "hovercv",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && node scripts/standalone.mjs",
    "start": "node scripts/start-production.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "demo": "tsx scripts/demo.ts",
    "postinstall": "node scripts/assets.mjs",
    "services": "node scripts/dev-services.mjs",
    "local:setup": "node scripts/local-env.mjs && npm run services && node --env-file=.env.local --import tsx scripts/migrate.ts",
    "backup": "node scripts/backup.mjs",
    "format": "prettier --write app components lib scripts tests *.ts *.json *.md compose.yaml"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "@floating-ui/react": "0.27.20",
    "better-auth": "1.7.10",
    "idb": "8.0.4",
    "jszip": "3.10.2",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "type": "module"
}
