# Official MinIO source, unchanged. Building needs access to Go module registries.
FROM golang:1.27.2-bookworm AS builder
WORKDIR /src
RUN git init && git remote add origin https://github.com/minio/minio.git && git fetch --depth 1 origin 07c3a429bfed433e49018cb0f78a52145d4bedeb && git checkout --detach FETCH_HEAD && test "$(git rev-parse HEAD)" = '07c3a429bfed433e49018cb0f78a52145d4bedeb'
RUN CGO_ENABLED=0 GOMAXPROCS=4 go build -p 4 -trimpath -o /minio .
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/* && useradd --uid 10001 --create-home minio && mkdir /data && chown minio /data
COPY --from=builder /minio /usr/local/bin/minio
COPY --from=builder /src/LICENSE /licenses/MinIO-LICENSE
LABEL org.opencontainers.image.source="https://github.com/minio/minio/tree/07c3a429bfed433e49018cb0f78a52145d4bedeb"
USER minio
EXPOSE 9000
ENTRYPOINT ["minio"]
CMD ["server","/data"]
