# 本地编辑/导出不需要以下配置。云草稿/账户/发布需要数据库与私有存储。
DATABASE_URL=postgresql://hovercv:change-me@localhost:5432/hovercv
BETTER_AUTH_URL=http://localhost:3000
# 使用 openssl rand -hex 32 生成独立密钥，至少 32 字符
BETTER_AUTH_SECRET=
# local 可用于单机私有目录，s3 用于 MinIO / S3
STORAGE_DRIVER=s3
LOCAL_STORAGE_DIR=.data/private
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=hovercv
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# AI 为可选增强，需要两个真实服务；所有密钥只在服务端使用
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
TAVILY_API_KEY=
# 图片仅从此列表中的 HTTPS 主机导入；还会检查 DNS/IP、响应类型、体积和重定向
IMAGE_ALLOWED_HOSTS=images.unsplash.com,images.pexels.com
